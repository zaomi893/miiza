#!/sbin/sh

umask 022
ui_print() { echo "$@"; }

OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null

if [ ! -f /data/adb/magisk/util_functions.sh ]; then
  ui_print "需要兼容的模块安装环境"
  exit 1
fi

. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -ge 20400 ] || {
  ui_print "需要 Magisk 20.4 或更高版本"
  exit 1
}

install_module
exit 0
