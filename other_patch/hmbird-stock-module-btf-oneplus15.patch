diff --git a/kernel/module/main.c b/kernel/module/main.c
index f6efc62..24d9673 100644
--- a/kernel/module/main.c
+++ b/kernel/module/main.c
@@ -283,6 +283,118 @@ static __maybe_unused void *any_section_objs(const struct load_info *info,
 	return (void *)info->sechdrs[sec].sh_addr;
 }
 
+#ifdef CONFIG_DEBUG_INFO_BTF_MODULES
+/*
+ * The stock OnePlus HMBIRD module is a split-BTF module produced against the
+ * stock PLK110 vmlinux.  It does not carry .BTF.base, so an otherwise ABI-
+ * compatible custom GKI interprets its base type IDs against the wrong BTF.
+ *
+ * The build workflow replaces the zero-filled initializer below with .BTF
+ * and .BTF_ids generated from the same HMBIRD source against this exact GKI.
+ * Only metadata is substituted: executable code and all other sections still
+ * come from the signed stock module in vendor_dlkm.
+ */
+#define OPLUS_HMBIRD_GKI_BTF_CAPACITY	32768U
+#define OPLUS_HMBIRD_BTF_IDS_SIZE	320U
+#define OPLUS_HMBIRD_BTF_ID_COUNT	39U
+
+
+#ifdef OPLUS_DEVICE_SERIAL_LOCK_ENABLED
+extern bool oplus_device_serial_verified(void);
+#endif
+
+static bool oplus_hmbird_serial_gate_verified(void)
+{
+#ifdef OPLUS_DEVICE_SERIAL_LOCK_ENABLED
+	return oplus_device_serial_verified();
+#else
+	/* Diagnostic/unlocked builds have no device-binding gate. */
+	return true;
+#endif
+}
+
+static const char * const oplus_known_bad_legacy_btf[] = {
+#include "oplus_legacy_btf_denylist.inc"
+};
+
+static const u8 oplus_hmbird_gki_btf[OPLUS_HMBIRD_GKI_BTF_CAPACITY] = {
+#include "oplus_hmbird_btf.inc"
+};
+
+/* The workflow replaces this marker with a little-endian payload length. */
+static const volatile u8 oplus_hmbird_gki_btf_size_slot[] = "HMBIRD_LEN_SLOT";
+
+static const u8 oplus_hmbird_gki_btf_ids[OPLUS_HMBIRD_BTF_IDS_SIZE] = {
+#include "oplus_hmbird_btf_ids.inc"
+};
+
+static bool oplus_is_known_bad_legacy_btf(const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(oplus_known_bad_legacy_btf); i++)
+		if (!strcmp(name, oplus_known_bad_legacy_btf[i]))
+			return true;
+	return false;
+}
+
+static void oplus_hmbird_fix_stock_btf(struct module *mod,
+				       const struct load_info *info)
+{
+	unsigned int btf_size;
+	unsigned int ids_size;
+	void *ids;
+
+	/* PLK110 already supplies the correct base BTF; preserve that path. */
+	if (mod->btf_base_data)
+		return;
+
+	/* Hide only the stock PLK110 legacy split-BTF modules verified bad. */
+	if (strcmp(mod->name, "oplus_bsp_sched_ext")) {
+		if (mod->btf_data && !mod->btf_base_data &&
+		    oplus_is_known_bad_legacy_btf(mod->name)) {
+			mod->btf_data = NULL;
+			mod->btf_data_size = 0;
+		}
+		return;
+	}
+	if (!oplus_hmbird_serial_gate_verified()) {
+		pr_err("%s: device binding rejected matching BTF metadata\n",
+		       mod->name);
+		return;
+	}
+	ids = any_section_objs(info, ".BTF_ids", 1, &ids_size);
+	if (!ids || ids_size != OPLUS_HMBIRD_BTF_IDS_SIZE ||
+	    ((u32 *)ids)[0] != OPLUS_HMBIRD_BTF_ID_COUNT) {
+		pr_err("%s: stock BTF ID layout mismatch: size=%u\n",
+		       mod->name, ids_size);
+		return;
+	}
+	if (!mod->btf_data) {
+		pr_err("%s: stock module has no BTF payload\n", mod->name);
+		return;
+	}
+
+	btf_size = (unsigned int)oplus_hmbird_gki_btf_size_slot[0] |
+		((unsigned int)oplus_hmbird_gki_btf_size_slot[1] << 8) |
+		((unsigned int)oplus_hmbird_gki_btf_size_slot[2] << 16) |
+		((unsigned int)oplus_hmbird_gki_btf_size_slot[3] << 24);
+	if (!btf_size || btf_size > OPLUS_HMBIRD_GKI_BTF_CAPACITY) {
+		pr_err("%s: embedded matching BTF size is invalid\n", mod->name);
+		return;
+	}
+
+	mod->btf_data = (void *)oplus_hmbird_gki_btf;
+	mod->btf_data_size = btf_size;
+	memcpy(ids, oplus_hmbird_gki_btf_ids,
+	       sizeof(oplus_hmbird_gki_btf_ids));
+	pr_info("%s: using embedded matching GKI BTF metadata\n", mod->name);
+}
+#else
+static inline void oplus_hmbird_fix_stock_btf(struct module *mod,
+					      const struct load_info *info) { }
+#endif
+
 #ifndef CONFIG_MODVERSIONS
 #define symversion(base, idx) NULL
 #else
@@ -3396,6 +3508,13 @@ static int load_module(struct load_info *info, const char __user *uargs,
 	if (err < 0)
 		goto free_modinfo;
 
+	/*
+	 * .BTF_ids is SHF_ALLOC and writable until complete_formation() applies
+	 * the module's final RO/NX permissions, so replace the metadata here.
+	 */
+	oplus_hmbird_fix_stock_btf(mod, info);
+
+
 	err = post_relocation(mod, info);
 	if (err < 0)
 		goto free_modinfo;
