 static int kernel_init(void *);
 
+#define OPLUS_SERIAL_SALT_SIZE 32
+#define OPLUS_SERIAL_MAX_SIZE 64
+#define OPLUS_SERIAL_BOOT_TOKEN_SIZE 64
+#define OPLUS_SERIAL_REBOOT_DELAY_SECONDS 180
+#define OPLUS_SERIAL_MARKER_PATH "/serial_lock/.mismatch"
+
+/* Per-build values. The workflow replaces all placeholders before compile. */
+static const u8 oplus_serial_salt[OPLUS_SERIAL_SALT_SIZE] = {
+	__OPLUS_SERIAL_SALT__
+};
+static const u8 oplus_serial_digest[SHA256_DIGEST_SIZE] = {
+	__OPLUS_SERIAL_DIGEST__
+};
+static const char oplus_serial_boot_token[OPLUS_SERIAL_BOOT_TOKEN_SIZE + 1] =
+	"__OPLUS_SERIAL_BOOT_TOKEN__";
+
+/* Fail closed if bootconfig is absent, malformed, or cannot be parsed. */
+static bool oplus_serial_lock_verified;
+
+bool oplus_device_serial_verified(void)
+{
+	return READ_ONCE(oplus_serial_lock_verified);
+}
+
+static void __init oplus_verify_device_serial(const char *serial)
+{
+	struct sha256_state state;
+	u8 digest[SHA256_DIGEST_SIZE];
+	size_t serial_len;
+
+	if (!serial)
+		return;
+	serial_len = strnlen(serial, OPLUS_SERIAL_MAX_SIZE + 1);
+	if (!serial_len || serial_len > OPLUS_SERIAL_MAX_SIZE)
+		return;
+
+	sha256_init(&state);
+	sha256_update(&state, oplus_serial_salt, sizeof(oplus_serial_salt));
+	sha256_update(&state, serial, serial_len);
+	sha256_final(&state, digest);
+	WRITE_ONCE(oplus_serial_lock_verified,
+		   !crypto_memneq(digest, oplus_serial_digest, sizeof(digest)));
+	memzero_explicit(digest, sizeof(digest));
+}
+
+static DECLARE_COMPLETION(oplus_serial_lock_armed);
+static bool oplus_serial_lock_is_armed;
+
+static bool __init oplus_serial_marker_matches(void)
+{
+	struct file *file;
+	char marker[OPLUS_SERIAL_BOOT_TOKEN_SIZE + 2] = { 0 };
+	loff_t pos = 0;
+	ssize_t len;
+
+	file = filp_open(OPLUS_SERIAL_MARKER_PATH, O_RDONLY, 0);
+	if (IS_ERR(file))
+		return false;
+	len = kernel_read(file, marker, OPLUS_SERIAL_BOOT_TOKEN_SIZE + 1, &pos);
+	filp_close(file, NULL);
+	if (len < 0)
+		return false;
+	while (len > 0 && (marker[len - 1] == '\n' || marker[len - 1] == '\r'))
+		marker[--len] = '\0';
+	return len == OPLUS_SERIAL_BOOT_TOKEN_SIZE &&
+		!crypto_memneq(marker, oplus_serial_boot_token,
+			       OPLUS_SERIAL_BOOT_TOKEN_SIZE);
+}
+
+static void __init __noreturn oplus_serial_lock_fail_closed(void)
+{
+	pr_emerg("device serial lock: refusing to start Android init\n");
+	for (;;) {
+		set_current_state(TASK_UNINTERRUPTIBLE);
+		schedule();
+	}
+}
+
+static ssize_t oplus_serial_lock_read(struct file *file, char __user *buf,
+				      size_t count, loff_t *ppos)
+{
+	const char *state;
+
+	if (oplus_device_serial_verified())
+		state = "verified\n";
+	else if (READ_ONCE(oplus_serial_lock_is_armed))
+		state = "mismatch-armed\n";
+	else
+		state = "mismatch-pending\n";
+	return simple_read_from_buffer(buf, count, ppos, state, strlen(state));
+}
+
+static ssize_t oplus_serial_lock_write(struct file *file,
+				       const char __user *buf,
+				       size_t count, loff_t *ppos)
+{
+	char command[5 + OPLUS_SERIAL_BOOT_TOKEN_SIZE + 2];
+	size_t len = min(count, sizeof(command) - 1);
+
+	if (oplus_device_serial_verified())
+		return count;
+	if (copy_from_user(command, buf, len))
+		return -EFAULT;
+	command[len] = '\0';
+	while (len > 0 && (command[len - 1] == '\n' || command[len - 1] == '\r'))
+		command[--len] = '\0';
+	if (len != 4 + OPLUS_SERIAL_BOOT_TOKEN_SIZE ||
+	    memcmp(command, "arm:", 4) ||
+	    crypto_memneq(command + 4, oplus_serial_boot_token,
+			   OPLUS_SERIAL_BOOT_TOKEN_SIZE))
+		return -EPERM;
+	if (!READ_ONCE(oplus_serial_lock_is_armed)) {
+		WRITE_ONCE(oplus_serial_lock_is_armed, true);
+		complete_all(&oplus_serial_lock_armed);
+	}
+	return count;
+}
+
+static const struct proc_ops oplus_serial_lock_proc_ops = {
+	.proc_read = oplus_serial_lock_read,
+	.proc_write = oplus_serial_lock_write,
+	.proc_lseek = default_llseek,
+};
+
+static int oplus_serial_lock_reboot_thread(void *unused)
+{
+	unsigned long remaining;
+
+	remaining = wait_for_completion_timeout(&oplus_serial_lock_armed,
+						OPLUS_SERIAL_REBOOT_DELAY_SECONDS * HZ);
+	if (!remaining) {
+		pr_emerg("device serial lock: delayed reboot timer failed to arm\n");
+		return 0;
+	}
+	set_current_state(TASK_INTERRUPTIBLE);
+	schedule_timeout(remaining);
+	pr_emerg("device serial lock: serial mismatch persisted for 180 seconds; restarting\n");
+	emergency_restart();
+	return 0;
+}
+
+static int __init oplus_serial_lock_start(void)
+{
+	if (oplus_device_serial_verified())
+		return 0;
+	/* Reboot timing is owned by the kernel and never depends on marker I/O. */
+	WRITE_ONCE(oplus_serial_lock_is_armed, true);
+	complete_all(&oplus_serial_lock_armed);
+	if (!proc_create("oplus_serial_lock", 0600, NULL,
+			 &oplus_serial_lock_proc_ops))
+		pr_emerg("device serial lock: failed to create control node\n");
+	if (IS_ERR(kthread_run(oplus_serial_lock_reboot_thread, NULL,
+			       "serial_lock_reboot")))
+		pr_emerg("device serial lock: failed to start delayed reboot thread\n");
+	return 0;
+}
+late_initcall(oplus_serial_lock_start);
+
 /*
  * Debug helper: via this flag we know that we are in 'early bootup code'
  * where only the boot processor is running with IRQ disabled.  This means
@@ -415,8 +578,10 @@ static void __init setup_boot_config(void)
 {
 	static char tmp_cmdline[COMMAND_LINE_SIZE] __initdata;
 	const char *msg, *data;
+	const char *device_serial;
 	int pos, ret;
 	size_t size;
+	struct xbc_node *serial_node;
 	char *err;
 
 	/* Cut out the bootconfig data even if we have no bootconfig option */
@@ -465,6 +630,13 @@ static void __init setup_boot_config(void)
 		extra_command_line = xbc_make_cmdline("kernel");
 		/* Also, "init." keys are init arguments */
 		extra_init_args = xbc_make_cmdline("init");
+
+		device_serial = xbc_find_value("androidboot.serialno", &serial_node);
+		oplus_verify_device_serial(device_serial);
+		if (!oplus_device_serial_verified())
+			pr_emerg("device serial lock: boot serial is missing or mismatched\n");
+		else
+			pr_info("device serial lock: verified\n");
 	}
 	return;
 }
@@ -1497,6 +1669,9 @@ static int __ref kernel_init(void *unused)
 	wait_for_completion(&kthreadd_done);
 
 	kernel_init_freeable();
+	if (!oplus_device_serial_verified() && oplus_serial_marker_matches())
+		oplus_serial_lock_fail_closed();
+
 	/* need to finish all async __init code before freeing the memory */
 	async_synchronize_full();
 
