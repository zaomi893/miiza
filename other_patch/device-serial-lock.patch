--- a/init/main.c
+++ b/init/main.c
@@ -18,6 +18,7 @@
 #include <linux/proc_fs.h>
 #include <linux/binfmts.h>
 #include <linux/kernel.h>
+#include <linux/reboot.h>
 #include <linux/syscalls.h>
 #include <linux/stackprotector.h>
 #include <linux/string.h>
@@ -103,6 +104,8 @@
 #include <linux/randomize_kstack.h>
 #include <linux/pidfs.h>
 #include <linux/ptdump.h>
+#include <crypto/sha2.h>
+#include <crypto/utils.h>
 #include <net/net_namespace.h>
 
 #include <asm/io.h>
@@ -117,6 +120,75 @@
 
 static int kernel_init(void *);
 
+#define OPLUS_SERIAL_SALT_SIZE 32
+#define OPLUS_SERIAL_MAX_SIZE 64
+#define OPLUS_SERIAL_REBOOT_DELAY_SECONDS 180
+
+/* Per-build values. The workflow replaces both placeholders before compile. */
+static const u8 oplus_serial_salt[OPLUS_SERIAL_SALT_SIZE] = {
+	__OPLUS_SERIAL_SALT__
+};
+static const u8 oplus_serial_digest[SHA256_DIGEST_SIZE] = {
+	__OPLUS_SERIAL_DIGEST__
+};
+
+/* Fail closed if bootconfig is absent, malformed, or cannot be parsed. */
+static bool oplus_serial_lock_verified;
+
+bool oplus_device_serial_verified(void)
+{
+	return READ_ONCE(oplus_serial_lock_verified);
+}
+
+static void __init oplus_verify_device_serial(const char *serial)
+{
+	struct sha256_state state;
+	u8 digest[SHA256_DIGEST_SIZE];
+	size_t serial_len;
+
+	if (!serial)
+		return;
+	serial_len = strnlen(serial, OPLUS_SERIAL_MAX_SIZE + 1);
+	if (!serial_len || serial_len > OPLUS_SERIAL_MAX_SIZE)
+		return;
+
+	sha256_init(&state);
+	sha256_update(&state, oplus_serial_salt, sizeof(oplus_serial_salt));
+	sha256_update(&state, serial, serial_len);
+	sha256_final(&state, digest);
+	WRITE_ONCE(oplus_serial_lock_verified,
+		   !crypto_memneq(digest, oplus_serial_digest, sizeof(digest)));
+	memzero_explicit(digest, sizeof(digest));
+}
+
+static int oplus_serial_lock_reboot_thread(void *unused)
+{
+	ssleep(OPLUS_SERIAL_REBOOT_DELAY_SECONDS);
+	if (oplus_device_serial_verified())
+		return 0;
+	pr_emerg("device serial lock: refusing to run on this device\n");
+	emergency_restart();
+	return 0;
+}
+
+static int __init oplus_serial_lock_start(void)
+{
+	struct task_struct *task;
+
+	if (oplus_device_serial_verified())
+		return 0;
+
+	pr_emerg("device serial lock: mismatch; emergency restart in %u seconds\n",
+		 OPLUS_SERIAL_REBOOT_DELAY_SECONDS);
+	task = kthread_run(oplus_serial_lock_reboot_thread, NULL,
+			   "serial_lock_reboot");
+	if (IS_ERR(task))
+		pr_emerg("device serial lock: failed to start restart thread: %ld\n",
+			 PTR_ERR(task));
+	return 0;
+}
+late_initcall(oplus_serial_lock_start);
+
 /*
  * Debug helper: via this flag we know that we are in 'early bootup code'
  * where only the boot processor is running with IRQ disabled.  This means
@@ -415,8 +487,10 @@ static void __init setup_boot_config(void)
 {
 	static char tmp_cmdline[COMMAND_LINE_SIZE] __initdata;
 	const char *msg, *data;
+	const char *device_serial;
 	int pos, ret;
 	size_t size;
+	struct xbc_node *serial_node;
 	char *err;
 
 	/* Cut out the bootconfig data even if we have no bootconfig option */
@@ -465,6 +539,13 @@ static void __init setup_boot_config(void)
 		extra_command_line = xbc_make_cmdline("kernel");
 		/* Also, "init." keys are init arguments */
 		extra_init_args = xbc_make_cmdline("init");
+
+		device_serial = xbc_find_value("androidboot.serialno", &serial_node);
+		oplus_verify_device_serial(device_serial);
+		if (!oplus_device_serial_verified())
+			pr_emerg("device serial lock: boot serial is missing or mismatched\n");
+		else
+			pr_info("device serial lock: verified\n");
 	}
 	return;
 }
