+    private fun isNoMountGloballyHidden(query: String): Boolean {
+        val now = SystemClock.uptimeMillis()
+        if (now - noMountGlobalCheckedAt >= 1000L) {
+            synchronized(noMountGlobalLock) {
+                if (now - noMountGlobalCheckedAt >= 1000L) {
+                    noMountGlobalCheckedAt = now
+                    val stamp = if (noMountGlobalFile.exists())
+                        noMountGlobalFile.lastModified() xor noMountGlobalFile.length()
+                    else Long.MIN_VALUE
+                    if (stamp != noMountGlobalStamp) {
+                        noMountGlobalPackages = runCatching {
+                            noMountGlobalFile.readLines().asSequence()
+                                .map(String::trim)
+                                .filter { it.isNotEmpty() && !it.startsWith("#") }
+                                .filter { it.matches(Regex("[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+")) }
+                                .toSet()
+                        }.getOrDefault(emptySet())
+                        noMountGlobalStamp = stamp
+                        logI(TAG) { "NoMount global policy loaded: ${noMountGlobalPackages.size} package(s)" }
+                    }
+                }
+            }
+        }
+        return query in noMountGlobalPackages
+    }
