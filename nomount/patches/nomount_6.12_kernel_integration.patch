diff --git a/fs/namei.c b/fs/namei.c
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -511,6 +511,13 @@ int inode_permission(struct mnt_idmap *idmap,
 		     struct inode *inode, int mask)
 {
 	int retval;
+#ifdef CONFIG_NOMOUNT
+	/* PathMask-compatible read/lookup hiding.  Write-class operations retain
+	 * native filesystem semantics instead of failing with a detectable errno. */
+	{ extern bool nomount_pathhide_hide_inode(const struct inode *);
+	  if (!(mask & MAY_WRITE) && nomount_pathhide_hide_inode(inode))
+		return -ENOENT; }
+#endif
 
 	retval = sb_permission(inode->i_sb, inode, mask);
 	if (retval)
