diff --git a/fs/proc/base.c b/fs/proc/base.c
--- a/fs/proc/base.c
+++ b/fs/proc/base.c
@@ -1842,6 +1842,16 @@
 	len = PTR_ERR(pathname);
 	if (IS_ERR(pathname))
 		goto out;
+#ifdef CONFIG_NOMOUNT
+	{ extern bool nomount_pathhide_match_path(const char *);
+	  if (nomount_pathhide_match_path(pathname)) {
+		const char *null_target = "/dev/null";
+		len = strlen(null_target);
+		if (copy_to_user(buffer, null_target, len))
+			len = -EFAULT;
+		goto out;
+	  } }
+#endif
 	len = tmp + PATH_MAX - 1 - pathname;
 
 	if (len > buflen)
