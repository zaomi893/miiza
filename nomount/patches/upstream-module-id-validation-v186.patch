+fn declared_module_id(dir: &Path) -> std::result::Result<String, String> {
+    let prop = fs::read_to_string(dir.join("module.prop"))
+        .map_err(|_| format!("cannot read {}", dir.join("module.prop").display()))?;
+    let id = prop
+        .lines()
+        .find_map(|line| line.strip_prefix("id="))
+        .map(str::trim)
+        .unwrap_or("");
+    if id.is_empty() {
+        return Err("module.prop has no id=".to_string());
+    }
+    Ok(id.to_string())
+}
